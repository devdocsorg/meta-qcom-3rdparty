From c1c98316e8787493ebf877d0e24e02cb067fcd01 Mon Sep 17 00:00:00 2001
From: Alan Vasquez <alan.vasquez@devdocs.work>
Date: Fri, 17 Jul 2026 14:48:42 -0300
Subject: [PATCH] arm64: dts: qcom: dragon-q6a: add CAM2 IMX219

Bring up the Sony IMX219 (Raspberry Pi Camera v2 / Radxa Camera 8M
219) on the Radxa Dragon Q6A CAM2 connector so it works as a
first-class camera on the board.

The sensor sits on CCI1 i2c-bus 0 at address 0x10 and streams over
CSIPHY2 into the sc7280 CAMSS. Add a fixed 24 MHz reference clock (the
module has its own oscillator), a fixed regulator driving the CAM2
power-down GPIO (gpio77), and a 128 MB CMA pool for RAW frame buffers.
Enable CCI1 and CAMSS and wire the CSIPHY2 <-> sensor endpoints.

Wiring is adapted from the Radxa CAM2 device-tree overlay.

Signed-off-by: Alan Vasquez <alan.vasquez@devdocs.work>
Assisted-by: Claude:claude-opus-4-8 [Claude Code]
---
 .../dts/qcom/qcs6490-radxa-dragon-q6a.dts     | 84 +++++++++++++++++++
 1 file changed, 84 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index bb5a42b..65477c3 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -1093,3 +1093,87 @@
 	bias-pull-up;
 	drive-strength = <10>;
 };
+
+/*
+ * CAM2: Sony IMX219 (Raspberry Pi Camera v2 / Radxa Camera 8M 219).
+ * Wiring adapted from the Radxa CAM2 overlay: CCI1 i2c-bus 0, CSIPHY2.
+ * The dt-bindings/clock/qcom,camcc-sc7280.h header is already pulled in
+ * by kodiak.dtsi, so it is not re-included here.
+ */
+/ {
+	ext_cam_clk_imx219: ext-cam-clk-imx219 {
+		compatible = "fixed-clock";
+		clock-frequency = <24000000>;	/* module has its own oscillator */
+		clock-output-names = "ext_cam_clk_imx219";
+		#clock-cells = <0>;
+	};
+
+	camera_pwdn_gpio_0: camera-pwdn-gpio-0 {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_pwdn_gpio_0";
+		regulator-always-on;
+		enable-active-high;
+		gpios = <&tlmm 77 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_pwdn_gpio_0>;
+	};
+};
+
+/* 128 MB CMA for RAW frame buffers */
+&{/reserved-memory} {
+	linux,cma {
+		compatible = "shared-dma-pool";
+		size = <0x0 0x8000000>;
+		reusable;
+		linux,cma-default;
+	};
+};
+
+&camss {
+	vdda-phy-supply = <&vreg_l10c_0p88>;
+	vdda-pll-supply = <&vreg_l6b_1p2>;
+	status = "okay";
+
+	ports {
+		port@2 {
+			reg = <2>;
+			csiphy2_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&imx219_0_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c0 {
+	status = "okay";
+
+	camera@10 {
+		compatible = "sony,imx219";
+		reg = <0x10>;
+		clocks = <&ext_cam_clk_imx219>;
+		clock-names = "ext_cam_clk_imx219";
+
+		port {
+			imx219_0_ep: endpoint {
+				link-frequencies = /bits/ 64 <456000000>;
+				data-lanes = <1 2>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	cam_pwdn_gpio_0: cam-pwdn-gpio-0-state {
+		pins = "gpio77";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
-- 
