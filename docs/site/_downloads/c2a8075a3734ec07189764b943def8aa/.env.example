# This layer does not load .env files. Export settings explicitly in your shell.
# Optional absolute kas work directory; kas defaults to its current work directory.
# Keep build output outside the checkout; preserve an already exported value.
# KAS_WORK_DIR=/home/user/.cache/meta-qcom-3rdparty/work
# Optional absolute shared download cache; upstream BitBake chooses DL_DIR if unset.
# DL_DIR=/home/user/.cache/meta-qcom-3rdparty/downloads
# Optional absolute shared shared-state cache; upstream BitBake chooses it if unset.
# SSTATE_DIR=/home/user/.cache/meta-qcom-3rdparty/sstate-cache
# Optional executable path; helper resolves kas-container on PATH when unset.
# KAS_CONTAINER=/home/user/.local/bin/kas-container
# Optional colon-separated kas input list used explicitly by example commands.
# KAS_YAMLS=ci/rubikpi3.yml:ci/qcom-distro.yml
# Checkout path used by the agent workflow; helper derives the path independently.
# REPO_DIR=/home/user/src/meta-qcom-3rdparty
