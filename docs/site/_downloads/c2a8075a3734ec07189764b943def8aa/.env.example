# This layer does not load .env automatically. Export chosen values in your shell.
# Optional absolute checkout path; CI scripts receive it as their first argument.
# export REPO_DIR=/work/meta-qcom-3rdparty
# Optional kas build workspace; defaults to kas's current working directory.
# export KAS_WORK_DIR=/work/yocto
# Optional shared source-download cache; unset uses the build's downloads directory.
# export DL_DIR=/work/cache/downloads
# Optional shared task cache; unset uses the build's sstate-cache directory.
# export SSTATE_DIR=/work/cache/sstate-cache
# Optional kas-container executable; helper otherwise resolves it on PATH.
# export KAS_CONTAINER=/opt/kas/bin/kas-container
# Optional fragment list for the documented commands; kas does not read this name itself.
# export KAS_YAMLS=ci/rubikpi3.yml:ci/qcom-distro.yml
# Optional container image version supported by kas-container; default follows wrapper version.
# export KAS_CONTAINER_IMAGE_VERSION=4.8.2
# Optional Docker/Podman selector used by kas-container; unset auto-selects available runtime.
# export KAS_CONTAINER_ENGINE=docker
# Do not put credentials in this file. CI secrets stay in GitHub Actions secrets.
