# This layer does not load .env automatically. Source only trusted shell settings.
# All settings below are optional strings; existing exported values take precedence.
# KAS_CONTAINER defaults to kas-container on PATH; use an absolute executable path.
# export KAS_CONTAINER="$HOME/.local/bin/kas-container"
# KAS_WORK_DIR defaults to the current checkout in kas; keep work outside it.
# export KAS_WORK_DIR="$HOME/.cache/meta-qcom-3rdparty/work"
# DL_DIR defaults to the build downloads directory; this shares downloaded sources.
# export DL_DIR="$HOME/.cache/yocto/downloads"
# SSTATE_DIR defaults to the build sstate-cache directory; this shares build results.
# export SSTATE_DIR="$HOME/.cache/yocto/sstate-cache"
# KAS_YAMLS is a convenience variable used only by the agent guide, not auto-loaded.
# export KAS_YAMLS="ci/rubikpi3.yml:ci/qcom-distro.yml"
# REPO_DIR is used by the CI scripts; invoke helpers from the repository root.
# export REPO_DIR="$PWD"
