# Environment settings for building this layer with kas-container.
# Nothing loads this file automatically: copy it to .env, edit the values, then
# run `set -a; . ./.env; set +a` before kas-container or the CI helper scripts.
# Sourcing the file replaces values already exported in the shell.
# docs/source/user/CONFIGURATION.md explains each setting.

# Optional path to the kas-container script used by
# ci/kas-container-shell-helper.sh. Unset: kas-container found on PATH.
KAS_CONTAINER=/opt/kas/kas-container

# Optional directory for layer checkouts and the build/ directory; keep it
# outside the repository. Unset: the current directory.
KAS_WORK_DIR=$HOME/kas-work

# Optional download cache shared between builds.
# Unset: build/downloads inside KAS_WORK_DIR.
DL_DIR=$HOME/yocto-cache/downloads

# Optional shared state cache reused between builds.
# Unset: build/sstate-cache inside KAS_WORK_DIR.
SSTATE_DIR=$HOME/yocto-cache/sstate-cache
