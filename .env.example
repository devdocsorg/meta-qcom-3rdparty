# Optional environment for kas-container builds. Nothing loads this file:
# export the variables you need in your shell before running kas-container or
# ci/kas-container-shell-helper.sh. Every variable is optional.

# Path to the kas-container script. Unset: the helper script runs the
# kas-container found on PATH.
KAS_CONTAINER=/usr/local/bin/kas-container

# Directory where kas clones layers and builds. Unset: the current directory.
# Keep it outside this checkout.
KAS_WORK_DIR=/srv/kas-work

# Shared download cache. Unset: a downloads directory inside the build.
DL_DIR=/srv/yocto-cache/downloads

# Shared-state cache. Unset: an sstate-cache directory inside the build.
SSTATE_DIR=/srv/yocto-cache/sstate-cache
