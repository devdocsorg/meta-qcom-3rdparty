# Environment settings for kas builds. Copy this file to .env, set the values,
# and load it into the current shell before running kas-container or the CI
# helper scripts:
#
#   set -a; . ./.env; set +a
#
# Every setting is optional. Loading the file replaces values already exported
# in the shell; delete a line to keep the shell's value. Keep every directory
# outside the repository checkout.

# Path of the kas-container script (string). ci/kas-container-shell-helper.sh
# uses it; when unset, the helper runs the kas-container found on PATH.
KAS_CONTAINER=/opt/kas/kas-container

# kas work directory (string, an existing directory). kas checks out the other
# layers and creates the build directory here. Unset: the current directory.
KAS_WORK_DIR=/srv/yocto/kas-work

# BitBake download cache (string, directory). kas-container creates it and
# passes it to the build. Unset: BitBake uses downloads/ in the build directory.
DL_DIR=/srv/yocto/cache/downloads

# BitBake shared state cache (string, directory). kas-container creates it and
# passes it to the build. Unset: BitBake uses sstate-cache/ in the build directory.
SSTATE_DIR=/srv/yocto/cache/sstate-cache
