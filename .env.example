# Reference shell settings; this file is not loaded automatically.
# Optional absolute executable path; the CI helper defaults to kas-container on PATH.
KAS_CONTAINER="$HOME/.local/bin/kas-container"
# Optional absolute work directory; kas otherwise uses its working directory.
# Keep build output outside the source checkout; preserve an existing value.
KAS_WORK_DIR="$HOME/.cache/meta-qcom-3rdparty/work"
# Optional absolute shared download directory; unset uses the kas/build default.
DL_DIR="$HOME/.cache/meta-qcom-3rdparty/downloads"
# Optional absolute shared state directory; unset uses the kas/build default.
SSTATE_DIR="$HOME/.cache/meta-qcom-3rdparty/sstate-cache"
# Optional colon-separated kas composition used by the agent guide's build commands.
# The CI shell helper always selects ci/base.yml; it does not read KAS_YAMLS.
KAS_YAMLS="ci/rubikpi3.yml:ci/qcom-distro.yml"
# Optional checkout path used by manual helper invocations; no automatic loading.
REPO_DIR="$PWD"
