# Environment settings for building the layer with kas-container, as the
# agent guide and CI do. Nothing loads this file: export the settings you need
# in your shell before running kas-container. Values set in the environment
# are used as they are; each setting says what applies when it is unset.

# Optional path. kas-container executable used by ci/kas-container-shell-helper.sh.
# Unset: the kas-container found on PATH.
KAS_CONTAINER=/home/user/bin/kas-container

# Optional path. Directory for the kas checkouts and the build directory; keep it
# outside the repository. Unset: the current working directory.
KAS_WORK_DIR=/home/user/kas-work

# Optional path. BitBake download cache shared between builds.
# Unset: build/downloads under KAS_WORK_DIR.
DL_DIR=/home/user/yocto-cache/downloads

# Optional path. BitBake shared-state cache shared between builds.
# Unset: build/sstate-cache under KAS_WORK_DIR.
SSTATE_DIR=/home/user/yocto-cache/sstate-cache
