# Environment settings for local kas-container builds and the layer checks.
# Copy this file to .env, adjust the paths, and load it into the shell:
#   set -a; . ./.env; set +a
# Every setting is optional. Keep the directories outside the checkout so the
# caches can be shared between builds.

# KAS_WORK_DIR (path): where kas-container checks out the other layers and
# builds, in build/ below it. The directory must exist.
# Unset: the current directory.
KAS_WORK_DIR=$HOME/yocto/kas-work

# DL_DIR (path): BitBake's download cache; kas-container creates it.
# Unset: build/downloads under KAS_WORK_DIR.
DL_DIR=$HOME/yocto/downloads

# SSTATE_DIR (path): BitBake's shared-state cache, which lets later builds
# reuse earlier results; kas-container creates it.
# Unset: build/sstate-cache under KAS_WORK_DIR.
SSTATE_DIR=$HOME/yocto/sstate-cache

# KAS_CONTAINER (path): the kas-container script that
# ci/kas-container-shell-helper.sh runs.
# Unset: kas-container found on PATH.
# KAS_CONTAINER=$HOME/.local/bin/kas-container
