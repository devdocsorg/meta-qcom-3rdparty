# Environment settings for the kas-container commands in the build tutorial and
# the agent guide. Copy this file to .env, adjust the paths, then load it into
# the current shell from the repository root:
#   set -a; . ./.env; set +a
# Every setting is optional. A value already set in the environment wins over
# the example value here.

# Directory where kas clones meta-qcom and the other layers and creates build/.
# Type: directory path, which must exist. Unset: the current directory. Keep it
# outside the repository.
KAS_WORK_DIR="${KAS_WORK_DIR:-$HOME/yocto/kas-work}"

# BitBake download cache, which builds can share. Type: directory path, created
# if missing. Unset: downloads/ in the kas build directory.
DL_DIR="${DL_DIR:-$HOME/yocto/downloads}"

# BitBake shared-state cache, which builds can share. Type: directory path,
# created if missing. Unset: sstate-cache/ in the kas build directory.
SSTATE_DIR="${SSTATE_DIR:-$HOME/yocto/sstate-cache}"

# kas-container script that ci/kas-container-shell-helper.sh runs. Type: file
# path. Unset: the kas-container found on PATH.
#KAS_CONTAINER="$HOME/.local/bin/kas-container"
