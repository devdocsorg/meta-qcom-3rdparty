# Environment variables read by the build helpers. Nothing loads this file:
# export the settings in your shell before running kas-container or the
# ci/ helper scripts, as docs/source/contributing/AGENTS.md shows. An
# environment value replaces the default below. All values here are safe
# examples; none of these settings holds a secret.

# Path to the kas-container script. Optional string. When unset,
# ci/kas-container-shell-helper.sh uses the kas-container found on PATH.
KAS_CONTAINER=/opt/kas/kas-container

# kas working directory for layer checkouts and the build directory.
# Optional path. When unset, kas-container uses the current directory; the
# agent guide recommends a directory outside this checkout.
KAS_WORK_DIR=/srv/yocto/kas-work

# BitBake download directory shared between builds. Optional path. When
# unset, downloads go under the build directory.
DL_DIR=/srv/yocto/cache/downloads

# BitBake shared-state cache directory. Optional path. When unset, the cache
# goes under the build directory.
SSTATE_DIR=/srv/yocto/cache/sstate-cache
