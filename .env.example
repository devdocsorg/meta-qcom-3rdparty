# Environment settings read by the build and check commands. Nothing loads this
# file: export the settings you need in your shell before running kas-container
# or the ci/ helper scripts. Every setting is optional.

# Path to the kas-container script, used by ci/kas-container-shell-helper.sh.
# Type: absolute file path. Unset: the kas-container found on PATH.
KAS_CONTAINER=/opt/kas/kas-container

# kas work directory, where kas clones the layers and creates the build
# directory. Keep it outside this checkout. Type: absolute directory path.
# Unset: the current directory.
KAS_WORK_DIR=/srv/yocto/kas-work

# BitBake download directory, shared between builds. Type: absolute directory
# path. Unset: downloads/ inside the build directory.
DL_DIR=/srv/yocto/shared-cache/downloads

# BitBake shared-state cache, shared between builds. Type: absolute directory
# path. Unset: sstate-cache/ inside the build directory.
SSTATE_DIR=/srv/yocto/shared-cache/sstate-cache
