# Environment settings for building this layer with kas-container, as the
# agent guide (docs/source/contributing/AGENTS.md) does. Every setting is
# optional. Copy this file to .env, change the values, create the work
# directory, and load the file into the current shell before running
# kas-container:
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   mkdir -p "$KAS_WORK_DIR"
# Values already set in the environment are kept.
# kas defines KAS_WORK_DIR, DL_DIR, and SSTATE_DIR:
# https://kas.readthedocs.io/en/latest/userguide/env-vars.html

# Path of the kas-container script that ci/kas-container-shell-helper.sh runs
# (file path). Unset: the kas-container found on PATH. Uncomment to use
# another copy.
# KAS_CONTAINER="$HOME/.local/bin/kas-container"

# kas work directory (existing directory path) that holds the layer
# checkouts and the build/ directory. Unset: the current directory. Keep it
# outside this checkout.
KAS_WORK_DIR="${KAS_WORK_DIR:-$HOME/kas-work}"

# BitBake download directory (directory path; kas-container creates it),
# shareable between builds. Unset: build/downloads in the kas work directory.
DL_DIR="${DL_DIR:-$HOME/yocto-cache/downloads}"

# BitBake shared-state cache directory (directory path; kas-container
# creates it), shareable between builds. Unset: build/sstate-cache in the
# kas work directory.
SSTATE_DIR="${SSTATE_DIR:-$HOME/yocto-cache/sstate-cache}"
