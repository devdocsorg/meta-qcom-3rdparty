# Optional host settings for kas-container. Load explicitly from the checkout:
# set -a; . ./.env.example; set +a
# Existing values take precedence over the examples below.

# Executable path string; optional, defaults to kas-container on PATH.
KAS_CONTAINER=${KAS_CONTAINER:-kas-container}
# Directory path string; optional to kas, which otherwise uses the current directory.
# Keep work outside the layer. Example: $HOME/.cache/meta-qcom-3rdparty/work.
KAS_WORK_DIR=${KAS_WORK_DIR:-${HOME}/.cache/meta-qcom-3rdparty/work}
# Directory path string; optional, otherwise BitBake uses build-local downloads.
DL_DIR=${DL_DIR:-${HOME}/.cache/yocto/downloads}
# Directory path string; optional, otherwise BitBake uses its build-local sstate cache.
SSTATE_DIR=${SSTATE_DIR:-${HOME}/.cache/yocto/sstate-cache}
