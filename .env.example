# Environment settings for kas-container builds and the CI helper scripts.
# Copy this file to .env, adjust the paths, and load it into the current shell:
#   set -a; . ./.env; set +a
# Each line keeps a value already set in the environment. Every setting is an
# optional path; the defaults below apply when a line is removed. Keep the
# folders outside the checkout so builds do not scan them.

# kas-container script that ci/kas-container-shell-helper.sh runs.
# Default: the kas-container found on PATH.
KAS_CONTAINER=${KAS_CONTAINER:-$HOME/.local/bin/kas-container}

# Folder where kas checks out the layers and creates build/.
# Must already exist. Default: the current folder.
KAS_WORK_DIR=${KAS_WORK_DIR:-$HOME/kas-work}

# Download cache that several builds can share; created when missing.
# Default: build/downloads in KAS_WORK_DIR.
DL_DIR=${DL_DIR:-$HOME/yocto-cache/downloads}

# Shared-state cache that several builds can share; created when missing.
# Default: build/sstate-cache in KAS_WORK_DIR.
SSTATE_DIR=${SSTATE_DIR:-$HOME/yocto-cache/sstate-cache}
