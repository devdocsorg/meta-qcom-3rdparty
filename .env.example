# Optional environment settings for kas builds and the CI helper scripts.
# Nothing loads this file: export the settings you need in your shell, for
# example `set -a; . ./.env; set +a` after copying it to .env. Every value
# here is safe to publish; keep the directories outside the checkout.

# Path to the kas-container script (string). Optional; when unset,
# ci/kas-container-shell-helper.sh uses the kas-container found on PATH.
KAS_CONTAINER=/usr/local/bin/kas-container

# Directory where kas checks out the other layers and runs the build (path).
# Optional; when unset, kas uses the current directory.
KAS_WORK_DIR=/srv/yocto/kas-work

# Shared download cache (path). Optional; when unset, BitBake uses
# build/downloads inside KAS_WORK_DIR.
DL_DIR=/srv/yocto/cache/downloads

# Shared-state cache that lets later builds reuse task output (path).
# Optional; when unset, BitBake uses build/sstate-cache inside KAS_WORK_DIR.
SSTATE_DIR=/srv/yocto/cache/sstate-cache
